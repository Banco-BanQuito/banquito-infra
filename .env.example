# ── Cloud SQL — PostgreSQL 18 (banquito-postgres) ──────────────────────────────
CLOUD_SQL_HOST=<IP_CLOUD_SQL_POSTGRES>
CLOUD_DB_USER=<USUARIO_POSTGRES>
CLOUD_DB_PASS=<CONTRASEÑA_POSTGRES>

# ── MongoDB Atlas ───────────────────────────────────────────────────────────────
# Formato: usuario:contraseña@cluster.host.net  (sin mongodb+srv://)
MONGO_ATLAS_URL=<USUARIO>:<CONTRASEÑA>@<CLUSTER>.mongodb.net

# ── RabbitMQ (Docker local) ─────────────────────────────────────────────────────
RABBITMQ_PASS=<CONTRASEÑA_RABBITMQ>

# ── Auth Service ────────────────────────────────────────────────────────────────
JWT_SECRET=<SECRETO_JWT_MINIMO_32_CHARS>
JWT_ISS=<NOMBRE_ISSUER>
ADMIN_PASSWORD=<CONTRASEÑA_ADMIN>
TELLER_PASSWORD=<CONTRASEÑA_CAJERO>
EMPRESA_PASSWORD=<CONTRASEÑA_EMPRESA>
CLIENTE_PASSWORD=<CONTRASEÑA_CLIENTE>

# ── SMTP (notificaciones) ────────────────────────────────────────────────────────
SMTP_PASS=<APP_PASSWORD_GMAIL>

# ── VM pública ───────────────────────────────────────────────────────────────────
VM_PUBLIC_IP=<IP_PUBLICA_VM>
